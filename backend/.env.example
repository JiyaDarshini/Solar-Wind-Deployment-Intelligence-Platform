# Database
DATABASE_URL=postgresql://swdi_user:swdi_password@localhost:5432/swdi_db

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# External data APIs
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# App
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
